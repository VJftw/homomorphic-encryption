load("@bazel_skylib//rules:run_binary.bzl", "run_binary")
load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_binary(
    name = "build",
    embed = [":build_lib"],
    visibility = ["//visibility:public"],
)

go_binary(
    name = "wasm",
    embed = [":build_lib"],
    goarch = "wasm",
    goos = "js",
    visibility = ["//visibility:public"],
)

run_binary(
    name = "wasm_brotli",
    srcs = [":wasm"],
    outs = ["wasm.br"],
    args = [
        "$(location :wasm)",
        "-o",
        "$(execpath wasm.br)",
    ],
    tool = "@brotli",
)

go_library(
    name = "build_lib",
    srcs = ["main.go"],
    importpath = "github.com/vjftw/homomorphic-encryption/pkg/frontend/static/build",
    visibility = ["//visibility:private"],
    deps = [
        "//pkg/frontend",
        "@com_github_maxence_charriere_go_app_v10//pkg/app",
    ],
)

run_binary(
    name = "site",
    srcs = [":wasm"],
    outs = [
        "app.css",
        "app.js",
        "app-worker.js",
        "index.html",
        "manifest.webmanifest",
        "wasm_exec.js",
        "web/app.wasm",
    ],
    args = [
        "$(execpath index.html)",
        "$(location :wasm)",
    ],
    tool = ":build",
    visibility = ["//visibility:public"],
)
